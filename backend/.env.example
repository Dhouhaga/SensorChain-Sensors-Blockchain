# Server
PORT=3000

# Blockchain RPC
RPC_URL=http://127.0.0.1:7545

# Deployed contract addresses
DEVICE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
SENSOR_CONSENSUS_ADDRESS=0x0000000000000000000000000000000000000000

# Admin wallet (do not commit real keys)
OWNER_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY

# Sensor wallets (one env var per registered sensor)
# Format: SENSOR_PRIVATE_KEY_<SENSOR_ADDRESS>=<PRIVATE_KEY>
SENSOR_PRIVATE_KEY_0xYOUR_SENSOR_ADDRESS=0xYOUR_SENSOR_PRIVATE_KEY
